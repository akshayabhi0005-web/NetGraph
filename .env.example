# NETGRAPH Environment Configuration Template
# Copy this file to .env or .env.local for local database integration.
# DO NOT commit real secrets or production credentials to source control.

# Runtime environment
NODE_ENV=development

# Application base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database Connection String (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example local Postgres connection:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/netgraph?schema=public"

# Authentication Secret (Used for session token generation / signing)
# In production, use a high-entropy string generated with: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-secure-random-secret-in-production"
